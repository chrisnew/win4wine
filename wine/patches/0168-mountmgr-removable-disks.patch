+         * says to leave alone. */
+        if (hint_ignore || hint_system || !size || !has_filesystem)
+        {
+            TRACE( "no drive for %s: file system %u size %s ignore %u system %u\n", debugstr_a(udi),
+                   has_filesystem, size ? "set" : "0", hint_ignore, hint_system );
+            udisks_removed_device( udi );  /* it may have been a drive before */
+            return;
+        }
+        if (drive_type == DEVICE_UNKNOWN) drive_type = DEVICE_HARDDISK;
+        hotplug.fs_type = type;
+    }
     if (device)
     {
-        if (removable) queue_device_op( ADD_DOS_DEVICE, udi, device, mount_point, drive_type, guid_ptr, id, label, NULL );
-        else if (guid_ptr) queue_device_op( ADD_VOLUME, udi, device, mount_point, DEVICE_HARDDISK_VOL, guid_ptr, id, label, NULL );
