+/* what UDisks2 said about the stick or memory card a device is, if it is one */
+static void set_hotplug_info( struct disk_device *device, const struct hotplug_info *info )
+{
+    free( (char *)device->hotplug.bus );
+    free( (char *)device->hotplug.vendor );
+    free( (char *)device->hotplug.product );
+    free( (char *)device->hotplug.fs_type );
+    free( (char *)device->hotplug.fs_uuid );
+    memset( &device->hotplug, 0, sizeof(device->hotplug) );
+    if (!info) return;
+    device->hotplug.bus = strdup( info->bus );
+    device->hotplug.vendor = info->vendor ? strdup( info->vendor ) : NULL;
+    device->hotplug.product = info->product ? strdup( info->product ) : NULL;
+    device->hotplug.fs_type = info->fs_type ? strdup( info->fs_type ) : NULL;
+    device->hotplug.fs_uuid = info->fs_uuid ? strdup( info->fs_uuid ) : NULL;
+}
+
 /* delete the disk device for a given drive */
 static void delete_disk_device( struct disk_device *device )
 {
@@ -716,6 +734,7 @@ static void delete_disk_device( struct disk_device *device )
     free( device->unix_device );
     free( device->unix_mount );
     free( device->serial );
+    set_hotplug_info( device, NULL );
     RtlFreeUnicodeString( &device->name );
     IoDeleteDevice( device->dev_obj );
 }
@@ -1247,10 +1266,28 @@ NTSTATUS remove_volume( const char *udi )
 }
 
 
+/* The user may not read the device itself, to see which file system it holds
+ * and its serial number: take them from UDisks2. */
+static void set_hotplug_volume_info( struct volume *volume, const struct hotplug_info *hotplug )
+{
+    unsigned int high, low;
+    char end;
+
+    if (volume->fs_type != FS_UNKNOWN || !hotplug->fs_type) return;
+    /* exFAT as FAT32, the nearest there is: XP shows no file system it cannot know */
+    if (strcmp( hotplug->fs_type, "vfat" ) && strcmp( hotplug->fs_type, "exfat" )) return;
+    volume->fs_type = FS_FAT32;
+
+    /* FAT's and exFAT's ID is the volume serial number */
+    if (hotplug->fs_uuid && sscanf( hotplug->fs_uuid, "%4x-%4x%c", &high, &low, &end ) == 2)
+        volume->serial = (high << 16) | low;
+}
+
 /* create a new dos drive */
 NTSTATUS add_dos_device( int letter, const char *udi, const char *device,
                          const char *mount_point, enum device_type type, const GUID *guid,
-                         const char *label, const struct scsi_info *scsi_info )
+                         const char *disk_serial, const char *label, const struct scsi_info *scsi_info,
+                         const struct hotplug_info *hotplug )
 {
     HKEY hkey;
     NTSTATUS status = STATUS_SUCCESS;
