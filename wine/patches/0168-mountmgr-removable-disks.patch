-    set_volume_info( volume, drive, device, mount_point, type, guid, label, NULL );
+    set_volume_info( volume, drive, device, mount_point, type, guid, label, disk_serial );
+    if (udi)
+    {
+        set_hotplug_info( volume->device, hotplug );
+        if (hotplug) set_hotplug_volume_info( volume, hotplug );
+    }
 
     TRACE( "added device %c: udi %s for %s on %s type %u\n",
            'a' + drive->drive, wine_dbgstr_a(udi), wine_dbgstr_a(device),
@@ -1550,6 +1592,18 @@ NTSTATUS query_unix_drive( void *buff, SIZE_T insize, SIZE_T outsize, IO_STATUS_
     return status;
 }
 
+/* Puts STRING at *END, if there is one; returns its offset from BASE, or 0. */
+static DWORD add_property_string( void *base, char **end, const char *string )
+{
+    DWORD offset;
+
+    if (!string) return 0;
+    offset = *end - (char *)base;
+    strcpy( *end, string );
+    *end += strlen( string ) + 1;
+    return offset;
+}
+
 static NTSTATUS query_property( struct disk_device *device, IRP *irp )
 {
     IO_STACK_LOCATION *irpsp = IoGetCurrentIrpStackLocation( irp );
@@ -1574,7 +1628,10 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
     {
         STORAGE_DEVICE_DESCRIPTOR *descriptor;
         DWORD len = sizeof(*descriptor);
+        const char *vendor = device->hotplug.vendor, *product = device->hotplug.product;
 
+        if (vendor) len += strlen( vendor ) + 1;
+        if (product) len += strlen( product ) + 1;
         if (device->serial) len += strlen( device->serial ) + 1;
 
         if (irpsp->Parameters.DeviceIoControl.OutputBufferLength < sizeof(STORAGE_DESCRIPTOR_HEADER))
@@ -1589,6 +1646,8 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
         }
         else
         {
+            char *end;
+
             FIXME( "Faking StorageDeviceProperty data\n" );
 
             memset( irp->AssociatedIrp.SystemBuffer, 0, irpsp->Parameters.DeviceIoControl.OutputBufferLength );
@@ -1597,19 +1656,18 @@ static NTSTATUS query_property( struct disk_device *device, IRP *irp )
             descriptor->Size = len;
             descriptor->DeviceType = FILE_DEVICE_DISK;
             descriptor->DeviceTypeModifier = 0;
-            descriptor->RemovableMedia = FALSE;
+            descriptor->RemovableMedia = device->hotplug.bus != NULL;
             descriptor->CommandQueueing = FALSE;
-            descriptor->VendorIdOffset = 0;
-            descriptor->ProductIdOffset = 0;
             descriptor->ProductRevisionOffset = 0;
-            descriptor->BusType = BusTypeScsi;
+            if (!device->hotplug.bus) descriptor->BusType = BusTypeScsi;
+            else if (!strcmp( device->hotplug.bus, "usb" )) descriptor->BusType = BusTypeUsb;
+            else if (!strcmp( device->hotplug.bus, "sdio" )) descriptor->BusType = BusTypeSd;
+            else descriptor->BusType = BusTypeScsi;
             descriptor->RawPropertiesLength = 0;
-            if (!device->serial) descriptor->SerialNumberOffset = 0;
-            else
-            {
-                descriptor->SerialNumberOffset = sizeof(*descriptor);
-                strcpy( (char *)descriptor + descriptor->SerialNumberOffset, device->serial );
-            }
+            end = (char *)(descriptor + 1);
+            descriptor->VendorIdOffset = add_property_string( descriptor, &end, vendor );
+            descriptor->ProductIdOffset = add_property_string( descriptor, &end, product );
+            descriptor->SerialNumberOffset = add_property_string( descriptor, &end, device->serial );
             irp->IoStatus.Information = len;
             status = STATUS_SUCCESS;
         }
