+struct hotplug_info
+{
+    const char *bus;      /* "usb", "sdio" or "" */
+    const char *vendor;
+    const char *product;
+    const char *fs_type;  /* "vfat", "exfat", ... */
+    const char *fs_uuid;  /* the file system's ID; "1234-ABCD" for FAT and exFAT */
+};
+
