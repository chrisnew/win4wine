                 }
+                else if (!strcmp( name, "Size" ))
+                    p_dbus_message_iter_get_basic( &variant, &size );
+                else if (!strcmp( name, "HintIgnore" ))
+                    p_dbus_message_iter_get_basic( &variant, &hint_ignore );
+                else if (!strcmp( name, "HintSystem" ))
+                    p_dbus_message_iter_get_basic( &variant, &hint_system );
                 else if (!strcmp( name, "IdUUID" ))
                 {
                     const char *uuid_str;
@@ -415,6 +432,7 @@ static void udisks2_add_device( const char *udi, DBusMessageIter *dict, DBusMess
                     else
                         p_dbus_message_iter_get_basic( &variant, &uuid_str );
                     guid_ptr = parse_uuid( &guid, uuid_str );
+                    hotplug.fs_uuid = uuid_str;
                 }
             }
         }
@@ -424,6 +442,10 @@ static void udisks2_add_device( const char *udi, DBusMessageIter *dict, DBusMess
            debugstr_a(udi), debugstr_a(device), debugstr_a(mount_point),
            debugstr_guid(guid_ptr), debugstr_a(type), debugstr_a(label), removable );
 
+    /* A removable drive that is neither optical nor a floppy drive: a USB stick
+     * or the card in a reader, whatever file system it holds. */
+    stick = removable && drive_type == DEVICE_UNKNOWN;
+
     if (type)
     {
         if (!strcmp( type, "iso9660" ))
@@ -437,10 +459,28 @@ static void udisks2_add_device( const char *udi, DBusMessageIter *dict, DBusMess
             drive_type = DEVICE_DVD;
         }
