diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index ac9e247..5374250 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2120,6 +2120,50 @@ static NTSTATUS fill_file_info( const struct stat *st, ULONG attr, void *ptr,
 }
 
 
+/* fill in FileStatInformation from the stat and attribute info */
+static void fill_stat_info( const struct stat *st, ULONG attr, ULONG reparse_tag, FILE_STAT_INFORMATION *info )
+{
+    FILE_BASIC_INFORMATION basic;
+    FILE_STANDARD_INFORMATION std;
+
+    fill_file_info( st, attr, &basic, FileBasicInformation );
+    fill_file_info( st, attr, &std, FileStandardInformation );
+
+    info->FileId.QuadPart = st->st_ino;
+    info->CreationTime   = basic.CreationTime;
+    info->LastAccessTime = basic.LastAccessTime;
+    info->LastWriteTime  = basic.LastWriteTime;
+    info->ChangeTime     = basic.ChangeTime;
+    info->AllocationSize = std.AllocationSize;
+    info->EndOfFile      = std.EndOfFile;
+    info->FileAttributes = attr;
+    info->ReparseTag     = reparse_tag;
+    info->NumberOfLinks  = std.NumberOfLinks;
+    info->EffectiveAccess = FILE_ALL_ACCESS; /* FIXME */
+}
+
+
+/* fill in FileStatLxInformation, which starts with FileStatInformation's fields */
+static void fill_stat_lx_info( const struct stat *st, ULONG attr, ULONG reparse_tag,
+                               FILE_STAT_LX_INFORMATION *info )
+{
+    fill_stat_info( st, attr, reparse_tag, (FILE_STAT_INFORMATION *)info );
+
+    info->LxFlags = LX_FILE_METADATA_HAS_UID | LX_FILE_METADATA_HAS_GID | LX_FILE_METADATA_HAS_MODE;
+    info->LxUid   = st->st_uid;
+    info->LxGid   = st->st_gid;
+    info->LxMode  = st->st_mode;
+    info->LxDeviceIdMajor = 0;
+    info->LxDeviceIdMinor = 0;
+    if (S_ISCHR( st->st_mode ) || S_ISBLK( st->st_mode ))
+    {
+        info->LxFlags |= LX_FILE_METADATA_HAS_DEVICE_ID;
+        info->LxDeviceIdMajor = major( st->st_rdev );
+        info->LxDeviceIdMinor = minor( st->st_rdev );
+    }
+}
+
+
 static unsigned int server_get_unix_name( HANDLE handle, char **unix_name )
 {
     data_size_t size = 1024;
@@ -4883,6 +4927,96 @@ NTSTATUS WINAPI NtQueryAttributesFile( const OBJECT_ATTRIBUTES *attr, FILE_BASIC
 }
 
 
+/* the stat info and attributes of a file by name, of a symbolic link itself */
+static unsigned int get_link_info( const char *unix_name, struct stat *st, ULONG *attr, ULONG *reparse_tag )
+{
+    struct stat target;
+
+    *reparse_tag = 0;
+    if (lstat( unix_name, st ) == -1) return errno_to_status( errno );
+    if (!S_ISLNK( st->st_mode ))
+    {
+        if (get_file_info( unix_name, st, attr, reparse_tag ) == -1) return errno_to_status( errno );
+    }
+    else
+    {
+        /* a link to a directory is a directory reparse point; a dangling link is only a reparse point */
+        if (get_file_info( unix_name, &target, attr, reparse_tag ) == -1) *attr = 0;
+        *attr |= FILE_ATTRIBUTE_REPARSE_POINT;
+        *reparse_tag = IO_REPARSE_TAG_LX_SYMLINK;
+    }
+    return STATUS_SUCCESS;
+}
+
+
+/******************************************************************************
+ *              NtQueryInformationByName   (NTDLL.@)
+ *
+ * Looks at the file by its name only: nothing is opened, so that a FIFO or a
+ * device is safe to ask about, and the wineserver is not involved (except for
+ * a name relative to a directory handle).
+ */
+NTSTATUS WINAPI NtQueryInformationByName( OBJECT_ATTRIBUTES *attr, IO_STATUS_BLOCK *io,
+                                          void *ptr, ULONG len, FILE_INFORMATION_CLASS class )
+{
+    OBJECT_ATTRIBUTES new_attr;
+    UNICODE_STRING nt_name;
+    char *unix_name;
+    struct stat st;
+    ULONG attributes, reparse_tag, size;
+    unsigned int status;
+
+    TRACE( "(%p,%p,%p,0x%08x,0x%08x)\n", attr, io, ptr, len, class );
+
+    switch (class)
+    {
+    case FileStatInformation:   size = sizeof(FILE_STAT_INFORMATION); break;
+    case FileStatLxInformation: size = sizeof(FILE_STAT_LX_INFORMATION); break;
+    default:
+        FIXME( "Unsupported class (%d)\n", class );
+        return STATUS_INVALID_INFO_CLASS;
+    }
+    if (len < size) return STATUS_INFO_LENGTH_MISMATCH;
+    if (!attr || !attr->ObjectName) return STATUS_INVALID_PARAMETER;
+
+    new_attr = *attr;
+    if (!(status = get_nt_and_unix_names( &new_attr, &nt_name, &unix_name, FILE_OPEN, TRUE )))
+    {
+        if (!new_attr.RootDirectory)
+            status = get_link_info( unix_name, &st, &attributes, &reparse_tag );
+        else
+        {
+            /* the Unix name is relative to that directory */
+            int root_fd, needs_close, cwd;
+
+            if (!(status = server_get_unix_fd( new_attr.RootDirectory, 0, &root_fd, &needs_close, NULL, NULL )))
+            {
+                mutex_lock( &dir_mutex );
+                cwd = open( ".", O_RDONLY );
+                if (fchdir( root_fd ) != -1)
+                {
+                    status = get_link_info( unix_name, &st, &attributes, &reparse_tag );
+                    if (cwd == -1 || fchdir( cwd ) == -1) chdir( "/" );
+                }
+                else status = errno_to_status( errno );
+                mutex_unlock( &dir_mutex );
+                if (cwd != -1) close( cwd );
+                if (needs_close) close( root_fd );
+            }
+        }
+    }
+    else WARN( "%s not found (%x)\n", debugstr_us(attr->ObjectName), status );
+    free( unix_name );
+    free( nt_name.Buffer );
+
+    if (status) return status;
+    if (class == FileStatInformation) fill_stat_info( &st, attributes, reparse_tag, ptr );
+    else fill_stat_lx_info( &st, attributes, reparse_tag, ptr );
+    io->Information = size;
+    return io->Status = STATUS_SUCCESS;
+}
+
+
 /******************************************************************************
  *              NtQueryInformationFile   (NTDLL.@)
  */
@@ -4961,7 +5095,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         0,                                             /* FileDesiredStorageClassInformation */
         sizeof(FILE_STAT_INFORMATION),                 /* FileStatInformation */
         0,                                             /* FileMemoryPartitionInformation */
-        0,                                             /* FileStatLxInformation */
+        sizeof(FILE_STAT_LX_INFORMATION),              /* FileStatLxInformation */
         0,                                             /* FileCaseSensitiveInformation */
         0,                                             /* FileLinkInformationEx */
         0,                                             /* FileLinkInformationExBypassAccessCheck */
@@ -5111,26 +5245,13 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         else if (!S_ISREG(st.st_mode) && !S_ISDIR(st.st_mode))
             status = STATUS_INVALID_INFO_CLASS;
         else
-        {
-            FILE_STAT_INFORMATION *info = ptr;
-            FILE_BASIC_INFORMATION basic;
-            FILE_STANDARD_INFORMATION std;
-
-            fill_file_info( &st, attr, &basic, FileBasicInformation );
-            fill_file_info( &st, attr, &std, FileStandardInformation );
-
-            info->FileId.QuadPart = st.st_ino;
-            info->CreationTime   = basic.CreationTime;
-            info->LastAccessTime = basic.LastAccessTime;
-            info->LastWriteTime  = basic.LastWriteTime;
-            info->ChangeTime     = basic.ChangeTime;
-            info->AllocationSize = std.AllocationSize;
-            info->EndOfFile      = std.EndOfFile;
-            info->FileAttributes = attr;
-            info->ReparseTag     = reparse_tag;
-            info->NumberOfLinks  = std.NumberOfLinks;
-            info->EffectiveAccess = FILE_ALL_ACCESS; /* FIXME */
-        }
+            fill_stat_info( &st, attr, reparse_tag, ptr );
+        break;
+    case FileStatLxInformation:
+        if (fd_get_file_info( handle, fd, options, &st, &attr, &reparse_tag ) == -1)
+            status = errno_to_status( errno );
+        else
+            fill_stat_lx_info( &st, attr, reparse_tag, ptr );
         break;
     default:
         FIXME("Unsupported class (%d)\n", class);
diff --git a/dlls/wow64/file.c b/dlls/wow64/file.c
index 09a455e..b44e47b 100644
--- a/dlls/wow64/file.c
+++ b/dlls/wow64/file.c
@@ -620,6 +620,28 @@ NTSTATUS WINAPI wow64_NtQueryFullAttributesFile( UINT *args )
 }
 
 
+/**********************************************************************
+ *           wow64_NtQueryInformationByName
+ */
+NTSTATUS WINAPI wow64_NtQueryInformationByName( UINT *args )
+{
+    OBJECT_ATTRIBUTES32 *attr32 = get_ptr( &args );
+    IO_STATUS_BLOCK32 *io32 = get_ptr( &args );
+    void *info = get_ptr( &args );
+    ULONG len = get_ulong( &args );
+    FILE_INFORMATION_CLASS class = get_ulong( &args );
+
+    struct object_attr64 attr;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+
+    status = NtQueryInformationByName( objattr_32to64_redirect( &attr, attr32 ),
+                                       iosb_32to64( &io, io32 ), info, len, class );
+    put_iosb( io32, &io );
+    return status;
+}
+
+
 /**********************************************************************
  *           wow64_NtQueryInformationFile
  */
diff --git a/include/winternl.h b/include/winternl.h
index 80c295f..046dc5d 100644
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -1797,6 +1797,32 @@ typedef struct _FILE_STAT_INFORMATION {
     ULONG EffectiveAccess;
 } FILE_STAT_INFORMATION, *PFILE_STAT_INFORMATION;
 
+typedef struct _FILE_STAT_LX_INFORMATION {
+    LARGE_INTEGER FileId;
+    LARGE_INTEGER CreationTime;
+    LARGE_INTEGER LastAccessTime;
+    LARGE_INTEGER LastWriteTime;
+    LARGE_INTEGER ChangeTime;
+    LARGE_INTEGER AllocationSize;
+    LARGE_INTEGER EndOfFile;
+    ULONG FileAttributes;
+    ULONG ReparseTag;
+    ULONG NumberOfLinks;
+    ULONG EffectiveAccess;
+    ULONG LxFlags;
+    ULONG LxUid;
+    ULONG LxGid;
+    ULONG LxMode;
+    ULONG LxDeviceIdMajor;
+    ULONG LxDeviceIdMinor;
+} FILE_STAT_LX_INFORMATION, *PFILE_STAT_LX_INFORMATION;
+
+#define LX_FILE_METADATA_HAS_UID        0x00000001
+#define LX_FILE_METADATA_HAS_GID        0x00000002
+#define LX_FILE_METADATA_HAS_MODE       0x00000004
+#define LX_FILE_METADATA_HAS_DEVICE_ID  0x00000008
+#define LX_FILE_CASE_SENSITIVE_DIR      0x00000010
+
 typedef struct _FILE_IO_COMPLETION_NOTIFICATION_INFORMATION {
     ULONG Flags;
 } FILE_IO_COMPLETION_NOTIFICATION_INFORMATION, *PFILE_IO_COMPLETION_NOTIFICATION_INFORMATION;
@@ -4712,6 +4738,7 @@ NTSYSAPI NTSTATUS  WINAPI NtQueryEaFile(HANDLE,PIO_STATUS_BLOCK,PVOID,ULONG,BOOL
 NTSYSAPI NTSTATUS  WINAPI NtQueryEvent(HANDLE,EVENT_INFORMATION_CLASS,PVOID,ULONG,PULONG);
 NTSYSAPI NTSTATUS  WINAPI NtQueryFullAttributesFile(const OBJECT_ATTRIBUTES*,FILE_NETWORK_OPEN_INFORMATION*);
 NTSYSAPI NTSTATUS  WINAPI NtQueryInformationAtom(RTL_ATOM,ATOM_INFORMATION_CLASS,PVOID,ULONG,ULONG*);
+NTSYSAPI NTSTATUS  WINAPI NtQueryInformationByName(POBJECT_ATTRIBUTES,PIO_STATUS_BLOCK,PVOID,ULONG,FILE_INFORMATION_CLASS);
 NTSYSAPI NTSTATUS  WINAPI NtQueryInformationFile(HANDLE,PIO_STATUS_BLOCK,PVOID,ULONG,FILE_INFORMATION_CLASS);
 NTSYSAPI NTSTATUS  WINAPI NtQueryInformationJobObject(HANDLE,JOBOBJECTINFOCLASS,PVOID,ULONG,PULONG);
 NTSYSAPI NTSTATUS  WINAPI NtQueryInformationPort(HANDLE,PORT_INFORMATION_CLASS,PVOID,ULONG,PULONG);
